---

<Layout title="Tech Stack Devs - App & Website Development">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 gradient-bg-subtle opacity-10 dark:opacity-20"></div>
    <div class="container mx-auto px-4 py-24 md:py-36 relative">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight gradient-text">
          We Code Your Vision
        </h1>
        <p class="text-xl md:text-2xl mb-10 max-w-2xl mx-auto" style="color: var(--text-secondary);">
          Transform your ideas into powerful digital solutions. Modern technology, exceptional design, fast delivery.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center flex-wrap">
          <a href="/contact" class="gradient-bg text-white px-8 py-4 rounded-xl font-semibold text-lg hover:opacity-90 transition-opacity shadow-lg shadow-primary-500/25">
            Start Your Project
          </a>
          <a href="/developers" class="gradient-bg text-white px-8 py-4 rounded-xl font-semibold text-lg hover:opacity-90 transition-opacity shadow-lg shadow-primary-500/25">
            Meet the Team
          </a>
          <a href="/pricing" class="gradient-bg text-white px-8 py-4 rounded-xl font-semibold text-lg hover:opacity-90 transition-opacity shadow-lg shadow-primary-500/25">
            View Our Prices
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Statement Section -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6" style="color: var(--text-primary);">
          Our Mission
        </h2>
        <p class="text-xl md:text-2xl leading-relaxed" style="color: var(--text-secondary);">
          We help businesses turn ideas into impact through collaborative consulting, scalable software, and practical AI integration.
        </p>
      </div>
    </div>
  </section>

  <!-- What We Do Section -->
  <section class="py-24" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--text-primary);">
            What We Build
          </h2>
          <p class="text-xl max-w-2xl mx-auto" style="color: var(--text-secondary);">
            From concept to launch, we craft digital experiences that drive results.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Web Apps -->
          <div class="p-8 rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <div class="w-14 h-14 rounded-xl bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-3" style="color: var(--text-primary);">Web Applications</h3>
            <p style="color: var(--text-secondary);">
              Powerful web apps built with modern frameworks. Fast, scalable, and beautiful.
            </p>
          </div>

          <!-- Mobile Apps -->
          <div class="p-8 rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <div class="w-14 h-14 rounded-xl bg-accent-500/10 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-3" style="color: var(--text-primary);">Mobile Apps</h3>
            <p style="color: var(--text-secondary);">
              iOS and Android apps that users love. Native performance, cross-platform efficiency.
            </p>
          </div>

          <!-- Websites -->
          <div class="p-8 rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <div class="w-14 h-14 rounded-xl bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-3" style="color: var(--text-primary);">Company Websites</h3>
            <p style="color: var(--text-secondary);">
              Stunning websites optimized for conversions. SEO-ready and lightning fast.
            </p>
          </div>

          <!-- SaaS -->
          <div class="p-8 rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <div class="w-14 h-14 rounded-xl bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-3" style="color: var(--text-primary);">SaaS Platforms</h3>
            <p style="color: var(--text-secondary);">
              Full-featured software-as-a-service products with subscriptions, multi-tenancy, and billing systems.
            </p>
          </div>

          <!-- E-Commerce -->
          <div class="p-8 rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <div class="w-14 h-14 rounded-xl bg-accent-500/10 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-3" style="color: var(--text-primary);">E-Commerce</h3>
            <p style="color: var(--text-secondary);">
              Online stores and marketplaces that drive sales. Custom or platform-based solutions tailored to your needs.
            </p>
          </div>

          <!-- AI & Automation -->
          <div class="p-8 rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <div class="w-14 h-14 rounded-xl bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-3" style="color: var(--text-primary);">AI & Automation</h3>
            <p style="color: var(--text-secondary);">
              Integrate AI capabilities and automate workflows to unlock new efficiencies and intelligent systems.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Us Section -->
  <section class="py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-4xl md:text-5xl font-bold mb-6 gradient-text">
              Why Work With Tech Stack Devs?
            </h2>
            <p class="text-lg mb-8" style="color: var(--text-secondary);">
              We're not just developers – we're partners in your success. Our team brings years of combined experience building products for startups and enterprises alike.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span style="color: var(--text-secondary);">Modern tech stack – React, Node.js, and more</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span style="color: var(--text-secondary);">Agile development with weekly updates</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span style="color: var(--text-secondary);">Transparent pricing, no hidden fees</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span style="color: var(--text-secondary);">Post-launch support included</span>
              </li>
            </ul>
          </div>
          <div class="grid grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl text-center" style="background-color: var(--bg-secondary);">
              <div class="text-4xl font-bold text-primary-500 mb-2">25+</div>
              <div style="color: var(--text-secondary);">Projects Delivered</div>
            </div>
            <div class="p-6 rounded-2xl text-center" style="background-color: var(--bg-secondary);">
              <div class="text-4xl font-bold text-accent-500 mb-2">100%</div>
              <div style="color: var(--text-secondary);">Client Satisfaction</div>
            </div>
            <div class="p-6 rounded-2xl text-center" style="background-color: var(--bg-secondary);">
              <div class="text-4xl font-bold text-primary-500 mb-2">10+</div>
              <div style="color: var(--text-secondary);">Industries Served</div>
            </div>
            <div class="p-6 rounded-2xl text-center" style="background-color: var(--bg-secondary);">
              <div class="text-4xl font-bold text-accent-500 mb-2">24/7</div>
              <div style="color: var(--text-secondary);">Support Available</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials - Commented out until we have real testimonials
  <section class="py-20" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--text-primary);">
            Client Stories
          </h2>
          <p class="text-xl max-w-2xl mx-auto" style="color: var(--text-secondary);">
            Don't just take our word for it — hear from the people we've worked with
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {testimonials.map((testimonial, index) => (
            <div 
              class="p-8 rounded-2xl relative"
              style={`background-color: var(--card-bg); box-shadow: var(--card-shadow);`}
            >
              <div class="absolute -top-4 left-8">
                <div class="w-10 h-10 gradient-bg rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                  </svg>
                </div>
              </div>
              
              <p class="text-lg mb-6 mt-4 italic" style="color: var(--text-secondary);">
                "{testimonial.quote}"
              </p>
              
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full gradient-bg flex items-center justify-center text-white font-bold">
                  {testimonial.avatar}
                </div>
                <div>
                  <div class="font-semibold" style="color: var(--text-primary);">{testimonial.author}</div>
                  <div class="text-sm" style="color: var(--text-muted);">{testimonial.role}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  -->

  <!-- CTA Section -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 gradient-bg"></div>
    <div class="container mx-auto px-4 relative">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-white">
          Ready to Build Something Great?
        </h2>
        <p class="text-xl mb-10 text-blue-100">
          Let's discuss your project and turn your vision into reality.
        </p>
        <a href="/contact" class="inline-block bg-white text-primary-600 px-8 py-4 rounded-xl font-semibold text-lg hover:bg-blue-50 transition-colors shadow-lg">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</Layout>