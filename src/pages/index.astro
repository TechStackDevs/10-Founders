---

<Layout title="Tech Stack Devs - App & Website Development" description="Tech Stack Devs is a collective studio of independent senior developers. We build web apps, mobile apps, SaaS platforms, and websites — no agency overhead, just direct access to senior talent.">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 gradient-bg-subtle opacity-10 dark:opacity-20"></div>
    <div class="container mx-auto px-4 py-24 md:py-36 relative">
      <div class="max-w-4xl mx-auto text-center">
        <img src="/images/Hexagon_logo_clr_DK.png" alt="Tech Stack Devs Logo" class="hidden md:block mx-auto mb-8 h-40 w-auto">
        <h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight gradient-text">
          We Code Your Vision
        </h1>
        <p class="text-xl md:text-2xl mb-10 max-w-2xl mx-auto" style="color: var(--text-secondary);">
          Transform your ideas into powerful digital solutions. Modern technology, exceptional design, fast delivery.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center flex-wrap">
          <a href="/contact" class="gradient-bg text-white px-8 py-4 rounded-xl font-semibold text-lg hover:opacity-90 transition-opacity shadow-lg shadow-primary-500/25">
            Start Your Project
          </a>
          <a href="/team" class="gradient-bg text-white px-8 py-4 rounded-xl font-semibold text-lg hover:opacity-90 transition-opacity shadow-lg shadow-primary-500/25">
            Meet the Team
          </a>
          <a href="/pricing" class="gradient-bg text-white px-8 py-4 rounded-xl font-semibold text-lg hover:opacity-90 transition-opacity shadow-lg shadow-primary-500/25">
            View Our Prices
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-16 md:py-20" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6" style="color: var(--text-primary);">
          Our Mission
        </h2>
        <p class="text-xl md:text-2xl leading-relaxed" style="color: var(--text-secondary);">
          Through collaborative partnerships, modern technology, and practical innovation, we turn ambitious ideas into production-ready applications that help businesses grow and scale with confidence.
        </p>
      </div>
    </div>
  </section>

  <!-- Who We Are Section -->
  <section class="who-we-are py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 wwa-heading" style="color: var(--text-primary);">
          Who We Are
        </h2>
        <p class="text-sm font-semibold uppercase tracking-wide mb-4 wwa-subtitle text-primary-500 dark:text-primary-400">
          A developer collective, not an agency
        </p>
        <p class="text-xl md:text-2xl leading-relaxed mb-6 wwa-text" style="color: var(--text-secondary);">
          Tech Stack Devs is a collective studio of independent senior developers. Every project is owned by a senior developer who leads the build and manages the client relationship directly — a builder first, not a non-technical manager. When a project needs more firepower, the project owner brings in other senior developers from the collective to collaborate.
        </p>
        <p class="text-lg leading-relaxed wwa-text" style="color: var(--text-secondary);">
          Your point of contact is always someone who's in the code. No account managers, no non-technical middlemen, and no inflated agency pricing — just senior-level talent, direct communication, and real accountability.
        </p>
      </div>
    </div>
  </section>

  <!-- What We Do Section -->
  <section class="py-24" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--text-primary);">
            What We Build
          </h2>
          <p class="text-xl max-w-2xl mx-auto" style="color: var(--text-secondary);">
            From concept to launch, we craft digital experiences that drive results.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Web Apps -->
          <div class="gradient-card p-8 rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <div class="text-3xl mb-6">⚙️</div>
            <h3 class="text-2xl font-bold mb-3 gc-heading" style="color: var(--text-primary);">Web Applications</h3>
            <p class="gc-text" style="color: var(--text-secondary);">
              Powerful web apps built with modern frameworks. Fast, scalable, and beautiful.
            </p>
          </div>

          <!-- Mobile Apps -->
          <div class="gradient-card p-8 rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <div class="text-3xl mb-6">📱</div>
            <h3 class="text-2xl font-bold mb-3 gc-heading" style="color: var(--text-primary);">Mobile Apps</h3>
            <p class="gc-text" style="color: var(--text-secondary);">
              iOS and Android apps that users love. Native performance, cross-platform efficiency.
            </p>
          </div>

          <!-- Websites -->
          <div class="gradient-card p-8 rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <div class="text-3xl mb-6">🌐</div>
            <h3 class="text-2xl font-bold mb-3 gc-heading" style="color: var(--text-primary);">Company Websites</h3>
            <p class="gc-text" style="color: var(--text-secondary);">
              Stunning websites optimized for conversions. SEO-ready and lightning fast.
            </p>
          </div>

          <!-- SaaS -->
          <div class="gradient-card p-8 rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <div class="text-3xl mb-6">🚀</div>
            <h3 class="text-2xl font-bold mb-3 gc-heading" style="color: var(--text-primary);">SaaS Platforms</h3>
            <p class="gc-text" style="color: var(--text-secondary);">
              Full-featured software-as-a-service products with subscriptions, multi-tenancy, and billing systems.
            </p>
          </div>

          <!-- E-Commerce -->
          <div class="gradient-card p-8 rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <div class="text-3xl mb-6">🛒</div>
            <h3 class="text-2xl font-bold mb-3 gc-heading" style="color: var(--text-primary);">E-Commerce</h3>
            <p class="gc-text" style="color: var(--text-secondary);">
              Online stores and marketplaces that drive sales. Custom or platform-based solutions tailored to your needs.
            </p>
          </div>

          <!-- AI & Automation -->
          <div class="gradient-card p-8 rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <div class="text-3xl mb-6">🧠</div>
            <h3 class="text-2xl font-bold mb-3 gc-heading" style="color: var(--text-primary);">AI & Automation</h3>
            <p class="gc-text" style="color: var(--text-secondary);">
              Integrate AI capabilities and automate workflows to unlock new efficiencies and intelligent systems.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Us Section -->
  <section class="py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-4xl md:text-5xl font-bold mb-6 gradient-text">
              Why Work With a Collective?
            </h2>
            <p class="text-lg mb-8" style="color: var(--text-secondary);">
              Traditional agencies charge for overhead you don't need — project managers, account reps, and layers between you and the people writing code. With Tech Stack Devs, you work with a vetted network of senior developers: every project has an owner who leads the build, and specialists join when the work calls for it — without the agency markup or bureaucracy.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span style="color: var(--text-secondary);">Every project is led by a senior developer who's in the code</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span style="color: var(--text-secondary);">Senior-level talent without agency-level pricing</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span style="color: var(--text-secondary);">A deep bench of specialists when your project needs more</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span style="color: var(--text-secondary);">Transparent pricing and real accountability</span>
              </li>
            </ul>
          </div>
          <div class="grid grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl text-center" style="background-color: var(--bg-secondary);">
              <div class="text-4xl font-bold text-primary-500 mb-2">15+</div>
              <div style="color: var(--text-secondary);">Independent Devs</div>
            </div>
            <div class="p-6 rounded-2xl text-center" style="background-color: var(--bg-secondary);">
              <div class="text-4xl font-bold text-accent-500 mb-2">1:1</div>
              <div style="color: var(--text-secondary);">Direct Access</div>
            </div>
            <div class="p-6 rounded-2xl text-center" style="background-color: var(--bg-secondary);">
              <div class="text-4xl font-bold text-primary-500 mb-2">24/7</div>
              <div style="color: var(--text-secondary);">Support Available</div>
            </div>
            <div class="p-6 rounded-2xl text-center" style="background-color: var(--bg-secondary);">
              <div class="text-4xl font-bold text-accent-500 mb-2">100%</div>
              <div style="color: var(--text-secondary);">Client Satisfaction</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials - Commented out until we have real testimonials
  <section class="py-20" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--text-primary);">
            Client Stories
          </h2>
          <p class="text-xl max-w-2xl mx-auto" style="color: var(--text-secondary);">
            Don't just take our word for it — hear from the people we've worked with
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {testimonials.map((testimonial, index) => (
            <div 
              class="p-8 rounded-2xl relative"
              style={`background-color: var(--card-bg); box-shadow: var(--card-shadow);`}
            >
              <div class="absolute -top-4 left-8">
                <div class="w-10 h-10 gradient-bg rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                  </svg>
                </div>
              </div>
              
              <p class="text-lg mb-6 mt-4 italic" style="color: var(--text-secondary);">
                "{testimonial.quote}"
              </p>
              
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full gradient-bg flex items-center justify-center text-white font-bold">
                  {testimonial.avatar}
                </div>
                <div>
                  <div class="font-semibold" style="color: var(--text-primary);">{testimonial.author}</div>
                  <div class="text-sm" style="color: var(--text-muted);">{testimonial.role}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  -->

  <!-- CTA Section -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 gradient-bg"></div>
    <div class="container mx-auto px-4 relative">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-white">
          Ready to Build Something Great?
        </h2>
        <p class="text-xl mb-10 text-blue-100">
          Let's discuss your project and turn your vision into reality.
        </p>
        <a href="/contact" class="inline-block bg-white text-primary-600 px-8 py-4 rounded-xl font-semibold text-lg hover:bg-blue-50 transition-colors shadow-lg">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</Layout>