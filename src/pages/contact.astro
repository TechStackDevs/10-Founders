---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us - Tech Stack Devs">
  <!-- Hero Section -->
  <section class="py-20 relative overflow-hidden">
    <div class="absolute inset-0 gradient-bg-subtle opacity-5 dark:opacity-10"></div>
    <div class="container mx-auto px-4 relative">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 gradient-text">
          Let's Talk
        </h1>
        <p class="text-xl" style="color: var(--text-secondary);">
          Have a project in mind? We'd love to hear about it. Reach out and let's start building something great together.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Form & Info -->
  <section class="py-20" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-16">
          <!-- Contact Form -->
          <div class="p-8 md:p-10 rounded-2xl" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
            <h2 class="text-3xl font-bold mb-6" style="color: var(--text-primary);">Send Us a Message</h2>
            <form class="space-y-6">
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-sm font-medium mb-2" style="color: var(--text-primary);">Name</label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required
                    class="w-full px-4 py-3 rounded-xl border transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                    style="background-color: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary);"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium mb-2" style="color: var(--text-primary);">Email</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required
                    class="w-full px-4 py-3 rounded-xl border transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                    style="background-color: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary);"
                    placeholder="your@email.com"
                  />
                </div>
              </div>
              
              <div>
                <label for="company" class="block text-sm font-medium mb-2" style="color: var(--text-primary);">Company (Optional)</label>
                <input 
                  type="text" 
                  id="company" 
                  name="company"
                  class="w-full px-4 py-3 rounded-xl border transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                  style="background-color: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary);"
                  placeholder="Your company"
                />
              </div>

              <div>
                <label for="project-type" class="block text-sm font-medium mb-2" style="color: var(--text-primary);">Project Type</label>
                <select 
                  id="project-type" 
                  name="project-type"
                  class="w-full px-4 py-3 rounded-xl border transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                  style="background-color: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary);"
                >
                  <option value="">Select a project type</option>
                  <option value="web-app">Web Application</option>
                  <option value="mobile-app">Mobile App</option>
                  <option value="website">CompanyWebsite</option>
                  <option value="ecommerce">E-Commerce</option>
                  <option value="api">API Development</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label for="budget" class="block text-sm font-medium mb-2" style="color: var(--text-primary);">Budget Range</label>
                <select 
                  id="budget" 
                  name="budget"
                  class="w-full px-4 py-3 rounded-xl border transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                  style="background-color: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary);"
                >
                  <option value="">Select a budget range</option>
                  <option value="5k-10k">$5,000 - $10,000</option>
                  <option value="10k-25k">$10,000 - $25,000</option>
                  <option value="25k-50k">$25,000 - $50,000</option>
                  <option value="50k+">$50,000+</option>
                  <option value="not-sure">Not sure yet</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium mb-2" style="color: var(--text-primary);">Tell Us About Your Project</label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="5" 
                  required
                  class="w-full px-4 py-3 rounded-xl border transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent resize-none"
                  style="background-color: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary);"
                  placeholder="Describe your project, goals, and timeline..."
                ></textarea>
              </div>

              <button 
                type="submit"
                class="w-full gradient-bg text-white py-4 rounded-xl font-semibold text-lg hover:opacity-90 transition-opacity shadow-lg shadow-primary-500/25"
              >
                Send Message
              </button>
            </form>
          </div>

          <!-- Contact Info -->
          <div class="space-y-8">
            <div>
              <h2 class="text-3xl font-bold mb-6" style="color: var(--text-primary);">Get in Touch</h2>
              <p class="text-lg leading-relaxed" style="color: var(--text-secondary);">
                We typically respond within 24 hours. Whether you have a detailed project specification or just a rough idea, we're here to help you figure out the best path forward.
              </p>
            </div>

            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold mb-1" style="color: var(--text-primary);">Email</h3>
                  <a href="mailto:contact@techstackdevs.com" class="text-primary-500 hover:text-primary-600 transition-colors">contact@techstackdevs.com</a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-accent-500/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold mb-1" style="color: var(--text-primary);">Response Time</h3>
                  <p style="color: var(--text-secondary);">Within 24 hours on business days</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold mb-1" style="color: var(--text-primary);">Schedule a Call</h3>
                  <p style="color: var(--text-secondary);">Book a free 30-minute consultation</p>
                </div>
              </div>
            </div>

            <!-- What to Expect -->
            <div class="p-6 rounded-xl" style="background-color: var(--bg-tertiary);">
              <h3 class="font-bold mb-4" style="color: var(--text-primary);">What Happens Next?</h3>
              <ol class="space-y-3">
                <li class="flex items-start gap-3">
                  <span class="w-6 h-6 rounded-full gradient-bg text-white text-sm flex items-center justify-center flex-shrink-0">1</span>
                  <span style="color: var(--text-secondary);">We review your message and project requirements</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-6 h-6 rounded-full gradient-bg text-white text-sm flex items-center justify-center flex-shrink-0">2</span>
                  <span style="color: var(--text-secondary);">Schedule a discovery call to discuss details</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-6 h-6 rounded-full gradient-bg text-white text-sm flex items-center justify-center flex-shrink-0">3</span>
                  <span style="color: var(--text-secondary);">Receive a detailed proposal and timeline</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-6 h-6 rounded-full gradient-bg text-white text-sm flex items-center justify-center flex-shrink-0">4</span>
                  <span style="color: var(--text-secondary);">Start building your project!</span>
                </li>
              </ol>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
