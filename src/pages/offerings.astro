---

<Layout title="Our Offerings - Tech Stack Devs" description="Web apps, mobile apps, SaaS platforms, e-commerce, AI integration, social media management, and more. See what Tech Stack Devs can build for your business.">
  <!-- Hero Section -->
  <section class="py-20 relative overflow-hidden">
    <div class="absolute inset-0 gradient-bg-subtle opacity-5 dark:opacity-10"></div>
    <div class="container mx-auto px-4 relative">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 gradient-text">
          What We Offer
        </h1>
        <p class="text-xl" style="color: var(--text-secondary);">
          Comprehensive development services to bring your ideas to life. From concept to deployment and beyond.
        </p>
      </div>
    </div>
  </section>

  <!-- Offerings Grid -->
  <section class="py-20" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {offerings.map((offering) => (
            <div class="p-6 rounded-2xl transition-all duration-300 hover:-translate-y-1 gradient-bg text-white">
              <h3 class="text-xl font-bold mb-3 text-white">
                {offering.title}
              </h3>
              <p class="mb-4 text-blue-100 text-sm">
                {offering.description}
              </p>
              <ul class="space-y-1.5">
                {offering.features.map((feature) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-blue-50 text-sm">
                      {feature}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- What We Can Build Section -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-7xl mx-auto">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 gradient-text">
            What We Can Build
          </h2>
          <p class="text-lg max-w-2xl mx-auto" style="color: var(--text-secondary);">
            Example project concepts showcasing the types of apps we can create for you.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {conceptProjects.map((project, index) => (
            <a
              href="/contact"
              class="group rounded-2xl overflow-hidden transition-all duration-500 hover:-translate-y-2 block"
              style={`background-color: var(--card-bg); box-shadow: var(--card-shadow); animation: fadeInUp 0.6s ease-out ${index * 0.1}s backwards;`}
            >
              <!-- Project Image -->
              <div class="relative h-56 overflow-hidden">
                <img 
                  src={project.image} 
                  alt={project.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
                <div class={`absolute inset-0 bg-gradient-to-t ${project.color} opacity-0 group-hover:opacity-70 transition-opacity duration-300`}></div>
                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <span class="px-6 py-3 bg-white text-gray-900 rounded-full font-semibold text-sm shadow-lg">
                    Let's Build This
                  </span>
                </div>
                <!-- Category Badge -->
                <div class="absolute top-4 left-4">
                  <span class={`px-3 py-1 rounded-full text-xs font-semibold bg-gradient-to-r ${project.color} text-white`}>
                    {project.category}
                  </span>
                </div>
              </div>
              
              <!-- Project Info -->
              <div class="p-6">
                <h3 class="text-xl font-bold mb-2" style="color: var(--text-primary);">
                  {project.title}
                </h3>
                <p class="text-sm mb-4 line-clamp-2" style="color: var(--text-secondary);">
                  {project.description}
                </p>
                <!-- Tags -->
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span 
                      class="px-2 py-1 rounded-md text-xs font-medium"
                      style="background-color: var(--bg-secondary); color: var(--text-muted);"
                    >
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--text-primary);">
            Our Process
          </h2>
          <p class="text-xl max-w-2xl mx-auto" style="color: var(--text-secondary);">
            A proven approach to delivering successful projects.
          </p>
        </div>

        <div class="grid md:grid-cols-4 gap-8">
          {[
            { step: '01', title: 'Discovery', desc: 'We learn about your business, goals, and requirements' },
            { step: '02', title: 'Planning', desc: 'Define scope, timeline, and technical architecture' },
            { step: '03', title: 'Development', desc: 'Build with weekly demos and continuous feedback' },
            { step: '04', title: 'Launch', desc: 'Deploy, test, and provide ongoing support' },
          ].map((item) => (
            <div class="text-center">
              <div class="text-6xl font-bold gradient-text mb-4">{item.step}</div>
              <h3 class="text-xl font-bold mb-2" style="color: var(--text-primary);">{item.title}</h3>
              <p style="color: var(--text-secondary);">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 relative overflow-hidden">
    <div class="absolute inset-0 gradient-bg"></div>
    <div class="container mx-auto px-4 relative">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-white">
          Let's Build Together
        </h2>
        <p class="text-xl mb-10 text-blue-100">
          Ready to start your project? Let's discuss how we can help.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-block bg-white text-primary-600 px-8 py-4 rounded-xl font-semibold text-lg hover:bg-blue-50 transition-colors shadow-lg">
            Contact Us
          </a>
          <a href="/pricing" class="inline-block border-2 border-white text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-white/10 transition-colors">
            View Pricing
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
