    features: [
      'Stripe subscription billing',
      'Multi-tenancy & user management',
      'Role-based access control',
      'Admin dashboards & analytics',
      'Production deployment & scaling',
    ],
  },
  {
    title: 'E-Commerce Solutions',
    description: 'Online stores and marketplaces that drive sales. Custom or platform-based solutions tailored to your needs.',
    features: [
      'Shopify/WooCommerce setup',
      'Custom e-commerce builds',
      'Payment integration',
      'Inventory management',
      'Order fulfillment systems',
    ],
  },
  {
    title: 'AI Implementation & Automation',
    description: 'Integrate AI capabilities into your workflows. Automate repetitive tasks and unlock new efficiencies with intelligent systems.',
    features: [
      'Custom AI integrations',
      'Workflow automation',
      'Chatbot development',
      'Document processing',
      'Predictive analytics',
    ],
  },
  {
    title: 'Social Media Management',
