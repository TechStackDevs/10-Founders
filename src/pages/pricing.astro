                {pkg.name}
              </h3>
              <div class={`text-2xl font-bold mb-4 ${pkg.highlighted ? 'text-white' : 'text-primary-500'}`}>
                {pkg.price}
              </div>
              <p class={`text-sm mb-4 ${pkg.highlighted ? 'text-blue-100' : ''}`} style={!pkg.highlighted ? 'color: var(--text-secondary);' : ''}>
                {pkg.description}
              </p>
              <ul class="space-y-2">
                {pkg.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm">
                    <svg class={`w-4 h-4 mt-0.5 shrink-0 ${pkg.highlighted ? 'text-blue-200' : 'text-primary-500'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class={pkg.highlighted ? 'text-blue-50' : ''} style={!pkg.highlighted ? 'color: var(--text-secondary);' : ''}>
                      {feature}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- AI Integration Packages -->
  <section id="ai" class="py-16 scroll-mt-28" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 gradient-text">
            🧠 AI Integration Packages
          </h2>
          <p class="text-lg" style="color: var(--text-secondary);">
            From plug-and-play chatbots to custom AI systems.
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {aiPackages.map((pkg) => (
            <div class={`p-6 rounded-2xl transition-all duration-300 hover:-translate-y-1 relative ${pkg.highlighted ? 'gradient-bg text-white' : ''}`} style={!pkg.highlighted ? 'background-color: var(--card-bg); box-shadow: var(--card-shadow);' : ''}>
              {pkg.highlighted && (
                <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-white text-primary-600 text-xs font-semibold rounded-full shadow-lg">
                  Popular
                </div>
              )}
              <h3 class={`text-lg font-bold mb-1 ${pkg.highlighted ? 'text-white' : ''}`} style={!pkg.highlighted ? 'color: var(--text-primary);' : ''}>
                {pkg.name}
              </h3>
              <div class={`text-xl font-bold mb-3 ${pkg.highlighted ? 'text-white' : 'text-primary-500'}`}>
                {pkg.price}
              </div>
              <p class={`text-sm mb-3 ${pkg.highlighted ? 'text-blue-100' : ''}`} style={!pkg.highlighted ? 'color: var(--text-secondary);' : ''}>
                {pkg.description}
              </p>
              <ul class="space-y-1 mb-3">
                {pkg.features.map((feature) => (
                  <li class="flex items-start gap-2 text-xs">
                    <svg class={`w-3 h-3 mt-0.5 flex-shrink-0 ${pkg.highlighted ? 'text-blue-200' : 'text-primary-500'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class={pkg.highlighted ? 'text-blue-50' : ''} style={!pkg.highlighted ? 'color: var(--text-secondary);' : ''}>
                      {feature}
                    </span>
                  </li>
                ))}
              </ul>
              <div class={`text-xs italic ${pkg.highlighted ? 'text-blue-200' : ''}`} style={!pkg.highlighted ? 'color: var(--text-muted);' : ''}>
                e.g., {pkg.examples}
              </div>
            </div>
          ))}
        </div>
        <!-- AI API Cost Note -->
        <div class="mt-8 p-4 rounded-xl border border-primary-500/30 bg-primary-500/5 text-center">
          <p class="text-sm" style="color: var(--text-secondary);">
            <strong class="text-primary-600 dark:text-primary-400">Note:</strong> Package prices cover AI integration and setup. Ongoing AI API costs (OpenAI, Anthropic, etc.) are included in our maintenance plans, or you can manage them directly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Add-ons Section -->
  <section id="addons" class="py-16 scroll-mt-28">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--text-primary);">
            Optional Add-ons
          </h2>
          <p class="text-lg" style="color: var(--text-secondary);">
            Enhance your project with additional services.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {addonCategories.map((category) => (
            <div class="space-y-4 scroll-mt-28" id={category.sectionId}>
              <h3 class="text-xl font-bold flex items-center gap-2" style="color: var(--text-primary);">
                <span>{category.icon}</span> {category.title}
              </h3>
              <div class="space-y-3">
                {category.addons.map((addon) => (
                  <div class="p-4 rounded-xl border transition-all duration-300 hover:border-primary-300 dark:hover:border-primary-600" style="background-color: var(--card-bg); border-color: var(--border-color);">
                    <div class="flex justify-between items-start mb-2">
                      <h4 class="font-semibold" style="color: var(--text-primary);">{addon.name}</h4>
                      <span class="text-sm font-bold text-primary-500 whitespace-nowrap ml-2">{addon.price}</span>
                    </div>
                    <p class="text-sm" style="color: var(--text-secondary);">{addon.description}</p>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Philosophy Note -->
  <section class="py-8">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="p-4 rounded-xl border border-primary-500/30 bg-primary-500/5 text-center">
          <p class="text-sm" style="color: var(--text-secondary);">
            <strong class="text-primary-600 dark:text-primary-400">We believe in transparent, fair pricing based on effort and complexity — not inflated retainers or surprise fees. Final pricing depends on scope, integrations, and timeline.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--text-primary);">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="space-y-6">
          {[
            { q: 'How do you determine final pricing?', a: 'We price projects as fixed-fee packages based on scope, complexity, and timeline. This gives you cost certainty and protects you from surprise billing. If scope changes during the project, we revise the quote before continuing.' },
            { q: 'What payment terms do you offer?', a: 'Typically, we work with a 50% deposit to start, with the remainder due upon completion. For larger projects, we can arrange milestone-based payments.' },
            { q: 'What payment methods do you accept?', a: 'We primarily accept payments via bank ACH transfers and Zelle for the fastest and most secure transactions. (Checks or credit card payments can be accommodated if necessary.)' },
            { q: 'Do you offer ongoing support?', a: 'Yes! All projects include initial support. We also offer monthly maintenance packages starting at $500/month for long-term partnerships.' },
            { q: 'How long does a typical project take?', a: 'Timeline varies based on scope. A simple website might take 2-4 weeks, while a complex application could be 3-6 months. We provide accurate estimates during our discovery phase.' },
            { q: 'What if my project doesn\'t fit these packages?', a: 'These packages are starting points. We customize every quote based on your specific needs. Reach out and we\'ll create a tailored proposal.' },
          ].map((faq) => (
            <div class="p-6 rounded-xl" style="background-color: var(--card-bg); box-shadow: var(--card-shadow);">
              <h3 class="text-lg font-bold mb-2" style="color: var(--text-primary);">{faq.q}</h3>
              <p style="color: var(--text-secondary);">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 relative overflow-hidden">
    <div class="absolute inset-0 gradient-bg"></div>
    <div class="container mx-auto px-4 relative">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-white">
          Ready to Get Started?
        </h2>
        <p class="text-xl mb-10 text-blue-100">
          Let's discuss your project and create a custom proposal tailored to your needs.
        </p>
        <a href="/contact" class="inline-block bg-white text-primary-600 px-8 py-4 rounded-xl font-semibold text-lg hover:bg-blue-50 transition-colors shadow-lg">
          Request a Quote
        </a>
      </div>
    </div>
  </section>
</Layout>
