// Add-ons organized by category (3 balanced categories)
const addonCategories = [
  {
    title: 'Growth & Marketing',
    icon: '📈',
    sectionId: 'addons-growth',
    addons: [
      { name: 'SEO Setup (One-Time)', price: '$500', description: 'Keyword research, optimization, analytics setup' },
      { name: 'Monthly SEO', price: '$500/mo', description: 'Ongoing optimization, technical audits, content updates, and performance reporting' },
      { name: 'Social Media Setup', price: '$500', description: 'Setup and branding for up to 3 platforms' },
      { name: 'Monthly Social Media Posting', price: '$500/mo', description: 'Content creation, scheduling, and reporting for one account. +$100/mo for each additional account.' },
