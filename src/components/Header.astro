---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Team', href: '/team' },
  // { label: 'Portfolio', href: '/portfolio' }, // Commented out until we have more projects
  { label: 'Offerings', href: '/offerings' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Contact', href: '/contact' },
];

// Normalize path by removing trailing slash (except for root)
const rawPath = Astro.url.pathname;
const currentPath = rawPath === '/' ? '/' : rawPath.replace(/\/$/, '');
---

<header class="fixed top-0 left-0 right-0 z-50 border-b transition-colors duration-300" style="background-color: var(--bg-primary); border-color: var(--border-color);">
  <nav class="container mx-auto px-4">
    <div class="flex items-center justify-between h-24">
      <!-- Logo - fixed width container to prevent layout shift -->
      <a href="/" class="flex items-center justify-start group w-48">
        <img src="/images/logo-no-bg.png" alt="Tech Stack Devs" class="h-14 w-auto block dark:hidden" />
        <img src="/images/logo-transparent.png.webp" alt="Tech Stack Devs" class="h-24 w-auto hidden dark:block" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'font-medium transition-colors hover:text-primary-500',
              currentPath === item.href ? 'text-primary-500' : ''
            ]}
            style={currentPath !== item.href ? 'color: var(--text-secondary);' : ''}
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Right side: Color theme + Dark/Light toggle + Mobile menu -->
      <div class="flex items-center justify-end gap-2 w-48">
        <!-- Color Theme Toggle -->
        <button
          id="color-theme-toggle"
          class="p-2 rounded-lg transition-colors hover:bg-primary-100 dark:hover:bg-primary-900/30"
          aria-label="Toggle color theme"
          title="Change color theme"
        >
          <!-- Color wheel icon -->
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="9" stroke="url(#colorWheelGradient)" />
            <circle cx="12" cy="12" r="4" fill="url(#colorWheelGradient)" />
            <defs>
              <linearGradient id="colorWheelGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#1e4263" />
                <stop offset="33%" stop-color="#7c3aed" />
                <stop offset="66%" stop-color="#ec4899" />
                <stop offset="100%" stop-color="#4dbdac" />
              </linearGradient>
            </defs>
          </svg>
        </button>

        <!-- Dark/Light Theme Toggle -->
        <button
          id="theme-toggle"
          class="p-2 rounded-lg transition-colors hover:bg-primary-100 dark:hover:bg-primary-900/30"
          aria-label="Toggle dark mode"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg class="w-5 h-5 hidden dark:block text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="w-5 h-5 block dark:hidden text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg transition-colors"
          style="color: var(--text-primary);"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t pt-4" style="border-color: var(--border-color);">
      <div class="flex flex-col gap-4">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'font-medium transition-colors hover:text-primary-500 py-2',
              currentPath === item.href ? 'text-primary-500' : ''
            ]}
            style={currentPath !== item.href ? 'color: var(--text-secondary);' : ''}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  // Available color themes (add more here as needed)
  const colorThemes = ['logo', 'blue-purple-pink'];

  // Dark/Light theme toggle functionality - dark mode is default
  function initTheme() {
    const themeToggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    
    // Default to dark mode unless explicitly set to light
    const savedTheme = localStorage.getItem('theme');
    
    if (savedTheme !== 'light') {
      html.classList.add('dark');
    }
    
    themeToggle?.addEventListener('click', () => {
      html.classList.toggle('dark');
      localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
    });
  }

  // Color theme toggle functionality
  function initColorTheme() {
    const colorThemeToggle = document.getElementById('color-theme-toggle');
    const html = document.documentElement;
    
    // Load saved color theme (default is 'logo' - no attribute needed)
    const savedColorTheme = localStorage.getItem('colorTheme') || 'logo';
    if (savedColorTheme !== 'logo') {
      html.setAttribute('data-color-theme', savedColorTheme);
    }
    
    colorThemeToggle?.addEventListener('click', () => {
      const currentTheme = html.getAttribute('data-color-theme') || 'logo';
      const currentIndex = colorThemes.indexOf(currentTheme);
      const nextIndex = (currentIndex + 1) % colorThemes.length;
      const nextTheme = colorThemes[nextIndex];
      
      if (nextTheme === 'logo') {
        html.removeAttribute('data-color-theme');
      } else {
        html.setAttribute('data-color-theme', nextTheme);
      }
      
      localStorage.setItem('colorTheme', nextTheme);
    });
  }

  // Mobile menu functionality
  function initMobileMenu() {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    
    mobileMenuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
  }

  // Initialize on page load
  initTheme();
  initColorTheme();
  initMobileMenu();

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:after-swap', () => {
    initTheme();
    initColorTheme();
    initMobileMenu();
  });
</script>
