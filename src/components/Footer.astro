---
const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/company/tech-stack-devs', // Update with your actual LinkedIn URL
    icon: 'linkedin',
  },
  {
    name: 'Twitter',
    href: 'https://x.com/TechStackDevs', // Update with your actual Twitter/X URL
    icon: 'twitter',
  },
  {
    name: 'Instagram',
    href: 'https://instagram.com/techstackdevs', // Update with your actual Instagram URL
    icon: 'instagram',
  },
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/profile.php?id=61585931731563',
    icon: 'facebook',
  },
  {
    name: 'TikTok',
    href: 'https://tiktok.com/@techstackdevs', // Update with your actual TikTok URL
    icon: 'tiktok',
  },
  {
    name: 'YouTube',
    href: 'https://youtube.com/@techstackdevs', // Update with your actual YouTube URL
    icon: 'youtube',
  },
];

const footerLinks = [
  {
    title: 'Company',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Offerings', href: '/offerings' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Pricing', href: '/pricing' },
      { label: 'Contact', href: '/contact' },
    ],
  },
];
---

<footer class="border-t transition-colors duration-300" style="background-color: var(--bg-secondary); border-color: var(--border-color);">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href="/" class="flex items-center mb-4">
          <img src="/images/logo-no-bg.png" alt="Tech Stack Devs" class="h-14 w-auto block dark:hidden" />
          <img src="/images/logo-transparent.png.webp" alt="Tech Stack Devs" class="h-24 w-auto hidden dark:block" />
        </a>
        <p class="max-w-sm leading-relaxed mb-6" style="color: var(--text-secondary);">
          Building exceptional apps and websites for businesses ready to grow. Modern solutions, crafted with care.
        </p>
        
        <!-- Social Links -->
        <div class="flex gap-4">
          {socialLinks.map((social) => (
            <a 
              href={social.href} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-lg flex items-center justify-center transition-all duration-300 hover:scale-110 hover:bg-primary-500 group"
              style="background-color: var(--bg-tertiary);"
              aria-label={social.name}
            >
              {social.icon === 'linkedin' && (
                <svg class="w-5 h-5 group-hover:text-white" style="color: var(--text-secondary);" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {social.icon === 'twitter' && (
                <svg class="w-5 h-5 group-hover:text-white" style="color: var(--text-secondary);" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
              {social.icon === 'instagram' && (
                <svg class="w-5 h-5 group-hover:text-white" style="color: var(--text-secondary);" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              )}
              {social.icon === 'github' && (
                <svg class="w-5 h-5 group-hover:text-white" style="color: var(--text-secondary);" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
              )}
              {social.icon === 'facebook' && (
                <svg class="w-5 h-5 group-hover:text-white" style="color: var(--text-secondary);" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              )}
              {social.icon === 'tiktok' && (
                <svg class="w-5 h-5 group-hover:text-white" style="color: var(--text-secondary);" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
                </svg>
              )}
              {social.icon === 'youtube' && (
                <svg class="w-5 h-5 group-hover:text-white" style="color: var(--text-secondary);" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Links -->
      {footerLinks.map((section) => (
        <div class="md:pt-14 dark:md:pt-20">
          <h3 class="font-semibold mb-4" style="color: var(--text-primary);">{section.title}</h3>
          <ul class="space-y-2">
            {section.links.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-primary-500" style="color: var(--text-secondary);">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t mt-12 pt-8 text-center" style="border-color: var(--border-color);">
      <p style="color: var(--text-muted);">
        &copy; {currentYear} Tech Stack Devs. All rights reserved.
      </p>
    </div>
  </div>
</footer>




